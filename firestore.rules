rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Iligan City MLS Listings Collection (Public View, Realtor Management)
    match /listings/{listingId} {
      allow read, write: if true;
    }
    
    // 2. Client Inquiries & Viewing Leads Collection (Public Inquire, Realtor Management)
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // 3. Broker Profile & Platform Settings Collection (Public View, Admin Profile Sync)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Comprehensive rule ensuring no collection or document is blocked
    match /{document=**} {
      allow read, write: if true;
    }
    
  }
}
